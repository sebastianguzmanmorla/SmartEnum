<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/</PackageOutputPath>
        <PackageId>SebastianGuzmanMorla.SmartEnum.EntityFrameworkCore</PackageId>
        <Version>1.0.7</Version>
        <Authors>Sebastián Guzmán Morla</Authors>
        <Description>Integración de SmartEnums con Entity Framework Core (converters y comparers).</Description>
        <PackageProjectUrl>https://github.com/sebastianguzmanmorla/SmartEnum</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sebastianguzmanmorla/SmartEnum.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageTags>smart-enum;enum;csharp;dotnet;entity-framework;efcore</PackageTags>
        <Copyright>© 2026 Sebastián Guzmán Morla</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="..\..\AGENTS.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SebastianGuzmanMorla.SmartEnum\SebastianGuzmanMorla.SmartEnum.csproj" />
    </ItemGroup>

</Project>
